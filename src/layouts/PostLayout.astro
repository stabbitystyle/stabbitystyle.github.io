---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title}>
	<p><em>{frontmatter.subtitle}</em></p>
	<p>Written by: {frontmatter.author}  |  Published: {frontmatter.pubDate.toLocaleDateString("en-us", {month: "long", day: "numeric", year: "numeric"})}</p>
	<hr>
	<slot />

	<div class="tags">
		{frontmatter.tags.map((tag: string) => (
			<p class="tag"><a href={`/tags/${tag}`}>{tag}</a></p>
		))}
	</div>
</BaseLayout>

<style>
	a {
		color: snow;
		text-decoration: none;
        display: block;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		padding: 0em 1em 1em 0em;
	}
</style>