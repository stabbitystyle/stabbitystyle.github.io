---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const pageTitle = "Posts";

allPosts.sort((a, b) => Date.parse(b.data.pubDate) - Date.parse(a.data.pubDate));
---

<BaseLayout pageTitle={pageTitle}>
    <p>This is where my blog resides.</p>
    <ul>
        {allPosts.map((post) => <BlogPost url={`/posts/${post.slug}/`} title={post.data.title} subtitle={post.data.subtitle} pubDate={post.data.pubDate} author={post.data.author} />)}
    </ul>
</BaseLayout>

<style>
    ul {
        list-style-type: none;
        padding-left: 0;
    }
</style>