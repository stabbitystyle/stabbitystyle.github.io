---
const { url, title, subtitle, pubDate, author } = Astro.props
---

<li>
    <a href={url}>
        <span class="title">{title}</span><br>
        <span class="subtitle">{subtitle}</span><br>
        <span class="info">Posted on {pubDate.toLocaleDateString("en-us", {month: "long", day: "numeric", year: "numeric"})} by {author}</span>
    </a>
</li>

<style>
    li {
        background: #858484;
        padding: 0.5em 1em;
    }
    li + li { /* lets me just format the space between two list items */
        margin: 0.2em 0
    }
    .title {
        font-size: 1.3em;
    }
    .subtitle {
        font-size: 1.0em;
        font-style: italic;
    }
    .info {
        font-size: 0.9em;
    }
</style>