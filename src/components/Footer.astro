---
import Social from "./Social.astro"
import blueskyIcon from '../../public/bluesky.svg';
import githubIcon from '../../public/github.svg';
import rssIcon from '../../public/rss.svg';
---

<footer>
    <div class="nav-links">
        <Social username="" href="" platform="Find me here:" isStarter="true" />
        <Social username="stabbitystyle.bsky.social" href="https://bsky.app/profile/" platform="BlueSky" icon={blueskyIcon} />
        <Social username="stabbitystyle" href="https://github.com/" platform="GitHub" icon={githubIcon} />
        <Social username="" href={new URL("rss.xml", Astro.site)} platform = "RSS" icon={rssIcon} />
    </div>
</footer>

<style>
    @media screen {
        .nav-links {
            margin-left: 5em;
            display: block;
            position: static;
            width: auto;
        }
    }
</style>