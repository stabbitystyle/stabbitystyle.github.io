---
const { href, platform, username, isStarter, icon } = Astro.props;
const isStarterBool = isStarter === "true"
---

<a href={`${href}${username}`} class={isStarterBool ? "starter nav-link" : "nav-link"} target="_blank">
    {isStarterBool ? "" : <img src={icon.src} alt={platform} width="auto" height="25px" style="vertical-align: middle;">} &nbsp{platform}
</a>

<style>
    .starter, .starter:hover, .starter:focus, .starter:focus:hover {
        user-select: none;
        pointer-events: none;
    }
</style>